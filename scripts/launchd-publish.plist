<?xml version="1.0" encoding="UTF-8"?>
<!-- 本机监听器：每天拉取云端推到 main 的当天动态，为各厂商建微信贴图草稿。
     云端（GitHub Actions daily.yml）北京时间 07:00 抓取渲染并直接 push main；
     本机 07:15 / 07:45 / 08:30 三次兜底跑 watch-and-publish.sh（吸收云端 cron 抖动，
     配合 .last_published.<vendor> 去重，每家每天只成功推一次）。
     兼容旧链路：若云端改推 daily-<DATE> 分支，脚本会自动合并进 main。
     安装：见 README / SKILL.md「云端抓取 → 本机推送」一节，或：
       cp scripts/launchd-publish.plist ~/Library/LaunchAgents/com.yinjialu.ai-frontier-daily.publish.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.yinjialu.ai-frontier-daily.publish.plist
     此文件为仓库参考副本；实际生效的是 ~/Library/LaunchAgents/ 下的同名文件，改后需 bootout + bootstrap 重载。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yinjialu.ai-frontier-daily.publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jialu/ai-frontier-daily/scripts/watch-and-publish.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/jialu</string>
    <key>PATH</key>
    <string>/Users/jialu/anaconda3/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/jialu/.nvm/versions/node/v24.13.0/bin:/usr/local/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/jialu/Library/Logs/ai-frontier-daily-publish.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jialu/Library/Logs/ai-frontier-daily-publish.log</string>
</dict>
</plist>
