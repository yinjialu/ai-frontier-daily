# AI 前哨 · 一手信源摘要模型配置（模板）
# ────────────────────────────────────────────────────────────────
# 安装位置（本机私密，勿提交仓库）：
#     ~/.config/ai-frontier-daily/firsthand.env
# 复制本模板并填值。monitor_firsthand.py 会在每次运行时读取该文件。
# ────────────────────────────────────────────────────────────────

FIRSTHAND_LLM_API_KEY=你的_DeepSeek_API_Key
FIRSTHAND_LLM_BASE_URL=https://api.deepseek.com/anthropic
FIRSTHAND_LLM_MODEL=deepseek-v4-flash
FIRSTHAND_LLM_TIMEOUT_SECONDS=120
