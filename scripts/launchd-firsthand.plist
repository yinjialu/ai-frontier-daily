<?xml version="1.0" encoding="UTF-8"?>
<!-- 本机一手信源内参监控：每小时 + 开机登录后跑 monitor_firsthand.py。
     抓 firsthand-sources.yaml 信源 → 新文章经 DeepSeek Anthropic-compatible API 出中文摘要
     （~/.config/ai-frontier-daily/firsthand.env）→ 写 data/firsthand/<id>/*.md(OKF)
     → 开 firsthand/<date> 分支 PR(reviewer=yinjialu)。详见 CLAUDE.md「一手信源内参监控」。
     通过 ~/.local/share/ai-frontier-daily/worktrees/firsthand 独立 worktree 运行，
     与主工作区及每日发布任务(com.yinjialu.ai-frontier-daily.publish)相互隔离。
     安装：scripts/install-firsthand-launchd.sh（symlink + bootstrap，git pull 自动生效）。
     此文件为仓库参考副本；实际生效的是 ~/Library/LaunchAgents/ 下同名 symlink，改后需 bootout + bootstrap 重载。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yinjialu.ai-frontier-daily.firsthand</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jialu/ai-frontier-daily/scripts/run-firsthand-launchd.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jialu/ai-frontier-daily</string>

  <!-- launchd 环境极简：显式给 HOME（模型私密配置 / git 凭据靠它）与 PATH（gh / git）。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/jialu</string>
    <key>PATH</key>
    <string>/Users/jialu/anaconda3/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/jialu/.nvm/versions/node/v24.13.0/bin:/usr/local/bin:/Users/jialu/.local/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>/Users/jialu/Library/Logs/ai-frontier-daily-firsthand.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jialu/Library/Logs/ai-frontier-daily-firsthand.log</string>
</dict>
</plist>
