.env
.server-state/
.server-packages/
seen.db
# 内参监控本地心跳（last_checked，每小时变，不提交以免刷屏 main）
data/.firsthand-heartbeat.json
node_modules/
dist/
.server-state/
.server-packages/
.venv/
__pycache__/
*.pyc

# 本机推送产物（勿污染工作区，以免影响 git pull --ff-only）
# .last_published* 含按厂商命名的 .last_published.<vendor>
.tmp/
.last_published*
output/**/小红书文案.txt
output/**/公众号图文.md
output/**/公众号贴图.md
# 本机预览辅助（端口/命令因机器而异）
.claude/launch.json

# 本地安装的 skills（npx skills add 安装目录，不入库）
.agents/skills/

# macOS 垃圾文件
.DS_Store
**/.DS_Store

# article-harness 迭代中间产物（成稿在 draft 同目录，工作区不提交）
content/deepdive/**/.harness-workspace/

# 发布运行产物（公众号草稿 API 响应/预览、小红书一次性打包），不进 git
content/deepdive/**/wechat-*.json
content/deepdive/**/wechat-preview.html
content/deepdive/**/xhs/
# 小红书渲染中间产物（含 base64 内联封面，体积大）
content/deepdive/**/_render.json
